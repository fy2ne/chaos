{
  "name": "wt-choas",
  "version": "1.1.0",
  "description": "Browser chaos engineering and fault injection plugin for Weavetab by fy2ne. CDP network throttling, CPU slowdown, API fault mocking, DOM boundary fuzzing, and automated crash telemetry.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "weavetab.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@weavetab/sdk": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "weavetab",
    "weavetab-plugin",
    "chaos",
    "choas",
    "wt-choas",
    "wt-chaos",
    "cdp",
    "fault-injection",
    "fuzzer",
    "race-condition"
  ],
  "author": {
    "name": "fy2ne",
    "url": "https://fy2ne.me"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fy2ne/chaos.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
